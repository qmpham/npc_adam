# Share this local vLLM configuration between client and MCP server.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Set this if the tokenization endpoint uses a different URL.
# VLLM_TOKENIZE_URL=http://127.0.0.1:8000/tokenize
VLLM_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
# Optional if the local vLLM server requires authentication.
VLLM_API_KEY=
# Hugging Face tokenizer ID or local tokenizer.json path. Defaults to VLLM_MODEL.
# CHAT_TOKENIZER=/path/to/tokenizer.json
PORT=8001
MCP_URL=http://127.0.0.1:8001/mcp
# Set a real contact email or project URL before using Wikipedia's API.
# WIKIPEDIA_USER_AGENT=AdamDialogueAssessment/1.0 (mailto:YOUR_REAL_EMAIL)

# Route requests, select Wikipedia pages, and rank memories.
SYSTEMONE_URL=http://localhost:8899/v1/systemone
DECISION_MODEL=vllm-sr/Decision-2.0-Kai-0.6B
